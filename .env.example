# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# MongoDB Configuration
#MONGO_URI=mongodb://localhost:27017/budgetsense
# Or for MongoDB Atlas:
MONGO_URI=mongodb+srv://budgetsense_user:<db_password>@budgetsense-cluster.jom2gi.mongodb.net/?appName=BudgetSense-Cluster

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# OCR (optional)
PYTESSERACT_PATH=/path/to/tesseract.exe  # Only for Windows